# ExpenSync Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas credentials:
# Example: mongodb+srv://myUser:SecretPass123@cluster0.ab1cd.mongodb.net/expensync?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://student_user:SecurePass2026@cluster0.mongodb.net/expensync_db?retryWrites=true&w=majority
